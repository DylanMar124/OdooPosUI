    /// <summary>
    /// Confirma el modal: abrir (con efectivo inicial), iniciar (caja en
    /// opening_control) o cerrar la caja, como en el Odoo original.
    /// </summary>
    private async Task ConfirmSessionModalAsync()
    {
        if (isProcessingSession) return;
        isProcessingSession = true;
        payError = null;
        payMessage = null;
        StateHasChanged();
        try
        {
            if (!sessionId.HasValue)
            {
                if (selectedConfigId <= 0)
                {
                    payError = "Selecciona un punto de venta para abrir la caja.";
                    return;
                }
                // Guarda: si ese PDV ya tiene caja abierta, no se crea otra
                // (Odoo lo rechaza); se cambia el modal a continuarla.
                var existing = await OdooService.GetSessionForConfigAsync(selectedConfigId);
                if (existing is not null && existing.Id > 0)
                {
                    sessionId = existing.Id;
                    sessionState = existing.State;
                    payError = existing.IsClosing
                        ? $"Ese punto de venta ya tiene la caja #{existing.Id} en control de cierre. Usa “Terminar cierre”."
                        : $"Ese punto de venta ya tiene la caja #{existing.Id} abierta. Usa “Iniciar caja”.";
                    return;
                }
                // Etapas 3+5: open register y luego opening control (como el dashboard)
                var newId = await Pipeline.OpenRegisterAsync(selectedConfigId);
                await Pipeline.SetOpeningControlAsync(newId, openingCash, cashNotes);
                await RefreshSessionAsync();
                payMessage = $"Caja abierta en Odoo (sesión #{newId}) con ${openingCash:0.00} iniciales. Ya puedes cobrar.";
            }
            else if (sessionState == "opening_control")
            {
                // Etapa 5: set opening control
                await Pipeline.SetOpeningControlAsync(sessionId.Value, openingCash, cashNotes);
                await RefreshSessionAsync();
                payMessage = $"Caja #{sessionId} iniciada con ${openingCash:0.00} iniciales.";
            }
            else
            {
                // Etapa 12: post closing detail
                await Pipeline.PostClosingDetailsAsync(sessionId.Value, new PosClosingDetails(closingCash, cashNotes));
                sessionId = null;
                sessionState = null;
                sessionData = null;
                closingData = null;
                await LoadPosConfigsAsync();
                payMessage = "Caja cerrada en Odoo.";
            }
            showSessionModal = false;
            openingCash = 0;
            closingCash = 0;
            cashNotes = string.Empty;
        }
        catch (Exception ex)
        {
            if (ex.Message.Contains("Another session is already opened", StringComparison.OrdinalIgnoreCase))
            {
                // Hay una sesión atorada (normalmente en control de cierre): recarga para
                // mostrarla y ofrece terminarla en vez de insistir en crear otra.
                await RefreshSessionAsync();
                payError = sessionId.HasValue
                    ? $"No se pudo abrir otra caja: la sesión #{sessionId} sigue sin cerrarse en Odoo. Usa “{(sessionState == "closing_control" ? "Terminar cierre" : "Iniciar caja")}”."
                    : "No se pudo abrir la caja: Odoo reporta otra sesión abierta para este punto de venta.";
            }
            else
            {
                payError = ex.Message;
                // Odoo exige el wizard de forzado: revela el botón de cierre forzado
                if (ex.Message.Contains("Force Close", StringComparison.OrdinalIgnoreCase)
                    || ex.Message.Contains("backend", StringComparison.OrdinalIgnoreCase))
                    showForceClose = true;
            }
        }
        finally
        {
            isProcessingSession = false;
            StateHasChanged();
        }
    }

    /// <summary>Etapa 12b: forzado vía pos.close.session.wizard (acepta el descuadre).</summary>
    private async Task ForceCloseAsync()
    {
        if (isProcessingSession || !sessionId.HasValue) return;
