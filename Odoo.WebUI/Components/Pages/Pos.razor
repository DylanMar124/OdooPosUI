    private async Task LoadProductsAsync()
    {
        isLoadingProducts = true;
        loadError = null;
        StateHasChanged();
        try
        {
            // Sesión POS con su estado (opened / opening_control / cerrada) + bundle.
            await RefreshSessionAsync();

            // Surtido oficial por caja: limit_categories + iface_available_categ_ids.
            // Sin sesión abierta no hay caja que restrinja: se muestra todo lo POS.
            int? configId = sessionData?.Session.ConfigId;
            posCategories = await Pipeline.GetPosCategoriesAsync(configId);

            // Etapa 7 del pipeline: productos jsonAPI del POS
            var list = await Pipeline.GetPosProductsAsync(configId, 200);
            var catNames = posCategories.ToDictionary(c => c.Id, c => c.Name);
            products = list.Select(p => new ProductDto
            {
                Id = p.Id,
                Name = p.Name,
                Price = p.Price,
                QtyAvailable = p.QtyAvailable,
                Category = p.PosCategIds is { Count: > 0 } && catNames.TryGetValue(p.PosCategIds[0], out var cn) ? cn : "Sin categoría",
                TaxIds = p.TaxIds ?? new(),
                PosCategIds = p.PosCategIds ?? new()
            }).ToList();

            if (selectedPosCategId != 0 && posCategories.All(c => c.Id != selectedPosCategId))
                selectedPosCategId = 0;

            if (products.Count == 0)
                products = DemoCatalog();
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
            products = DemoCatalog();
        }
        finally
        {
            isLoadingProducts = false;
            StateHasChanged();
        }
    }

