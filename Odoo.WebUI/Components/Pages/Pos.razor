    private decimal Iva => cart.Sum(i => Math.Round(i.LineTotal * i.TaxRate, 2));
    private decimal Total => Subtotal + Iva;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Guard real: restaura la sesión persistida (sobrevive a F5). Sin login, fuera.
        // Durante el prerender TryRestoreAsync devuelve false (sin JS interop); el
        // intento válido ocurre al conectar el circuito interactivo.
        if (!await AuthState.TryRestoreAsync())
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        await Task.WhenAll(LoadProductsAsync(), LoadCustomersAsync());
    }

