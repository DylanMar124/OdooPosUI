    private static bool AtMax(CartItem item)
        => item.StockQty > 0 && item.Qty >= (int)Math.Floor(item.StockQty);

    private void IncreaseQty(CartItem item)
    {
        stockNotice = null;
        if (AtMax(item))
        {
            stockNotice = $"“{item.Name}” solo tiene {item.StockQty:0.##} en existencia.";
            return;
        }
        item.Qty++;
    }

    private void DecreaseQty(CartItem item)
    {
        stockNotice = null;
        item.Qty--;
        if (item.Qty <= 0)
            cart.Remove(item);
    }

    private void Remove(CartItem item)
    {
        stockNotice = null;
        cart.Remove(item);
    }

    private void ClearCart()
    {
