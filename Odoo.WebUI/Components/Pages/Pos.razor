    private async Task PrintTicketAsync()
    {
        // Impresión aislada en iframe (documento standalone): evita el error de JS
        // que el entorno de la página provocaba con window.print directo.
        if (lastTicket is null) return;
        try
        {
            var ok = await JSRuntime.InvokeAsync<bool>("odooPrint.printHtml", "print-frame", BuildTicketHtml());
            if (!ok)
                payError = "No se pudo abrir la impresión (iframe no disponible).";
        }
        catch { /* sin JS (prerender): se ignora */ }
    }

    /// <summary>Documento térmico standalone (sin Tailwind/Bootstrap): 80mm, solo texto.</summary>
    private string BuildTicketHtml()
    {
        var t = lastTicket!;
        static string E(string? s) => System.Net.WebUtility.HtmlEncode(s ?? string.Empty);
        static string M(decimal v) => v.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
        var sb = new StringBuilder();
        sb.Append("<!DOCTYPE html><html><head><meta charset=\"utf-8\"><title>Ticket #");
        sb.Append(t.OrderId);
        sb.Append("</title><style>");
        sb.Append("body{font-family:'Courier New',monospace;font-size:12px;color:#000;width:72mm;margin:0 auto;padding:4mm 2mm;}");
        sb.Append("h1{font-size:15px;text-align:center;margin:0 0 2px;}");
        sb.Append("p{margin:1px 0;}table{width:100%;border-collapse:collapse;}td{vertical-align:top;padding:1px 0;}");
        sb.Append(".r{text-align:right;}.c{text-align:center;}.tot{font-size:15px;font-weight:bold;}");
        sb.Append("hr{border:none;border-top:1px dashed #000;margin:6px 0;}");
        sb.Append("</style></head><body>");
        sb.Append("<h1>").Append(E(t.ConfigName)).Append("</h1>");
        sb.Append("<p class=\"c\">Ticket de venta</p><hr>");
        sb.Append("<table>");
        sb.Append("<tr><td>Orden</td><td class=\"r\"><b>#").Append(t.OrderId).Append("</b></td></tr>");
        sb.Append("<tr><td>Fecha</td><td class=\"r\">").Append(E(t.Date.ToString("dd/MM/yyyy HH:mm"))).Append("</td></tr>");
        sb.Append("<tr><td>Cajero</td><td class=\"r\">").Append(E(t.Cashier)).Append("</td></tr>");
        sb.Append("<tr><td>Cliente</td><td class=\"r\">").Append(E(t.Customer)).Append("</td></tr>");
        sb.Append("<tr><td>Sesi&oacute;n</td><td class=\"r\">#").Append(t.SessionId).Append("</td></tr>");
        sb.Append("</table><hr><table>");
        foreach (var l in t.Lines)
        {
            sb.Append("<tr><td>").Append(l.Qty).Append(" x ").Append(E(l.Name))
              .Append(" ($").Append(M(l.UnitPrice)).Append(")</td>")
              .Append("<td class=\"r\"><b>$").Append(M(l.LineTotal)).Append("</b></td></tr>");
        }
        sb.Append("</table><hr><table>");
        sb.Append("<tr><td>Subtotal</td><td class=\"r\">$").Append(M(t.Subtotal)).Append("</td></tr>");
        sb.Append("<tr><td>IVA</td><td class=\"r\">$").Append(M(t.Tax)).Append("</td></tr>");
        sb.Append("<tr class=\"tot\"><td>TOTAL</td><td class=\"r\">$").Append(M(t.Total)).Append("</td></tr>");
        sb.Append("</table><hr><table>");
        sb.Append("<tr><td>Pago</td><td class=\"r\">").Append(E(t.MethodLabel)).Append("</td></tr>");
        sb.Append("<tr><td>Monto</td><td class=\"r\">$").Append(M(t.Total)).Append("</td></tr>");
        sb.Append("<tr><td>Cambio</td><td class=\"r\">$0.00</td></tr>");
        sb.Append("</table><hr><p class=\"c\"><b>&iexcl;Gracias por su compra!</b></p>");
        sb.Append("</body></html>");
        return sb.ToString();
    }

    public sealed record TicketLine(string Name, int Qty, decimal UnitPrice, decimal LineTotal);

    public sealed class TicketDto
    {
        public int OrderId { get; set; }
        public int SessionId { get; set; }
        public string ConfigName { get; set; } = string.Empty;
        public DateTime Date { get; set; }
        public string Cashier { get; set; } = string.Empty;
        public string Customer { get; set; } = string.Empty;
        public string MethodLabel { get; set; } = string.Empty;
        public List<TicketLine> Lines { get; set; } = new();
        public decimal Subtotal { get; set; }
        public decimal Tax { get; set; }
        public decimal Total { get; set; }
    }

    // CartItem vive en Odoo.WebUI.Services (compartido con OdooService.CrearOrdenPosAsync).
}
