    private async Task RefreshSessionAsync()
    {
        var info = await OdooService.GetActiveSessionAsync();
        sessionId = info?.Id;
        sessionState = info?.State;
        // Etapa 6 del pipeline: bundle de sesión (config, pagos, impuestos)
        if (sessionId.HasValue && info!.IsOpened)
        {
            try { sessionData = await Pipeline.LoadSessionDataAsync(sessionId.Value); }
            catch { sessionData = null; }
        }
        else
        {
            sessionData = null;
        }
        // PDV disponibles para el modal de apertura
        if (!sessionId.HasValue)
            await LoadPosConfigsAsync();
    }

