    // Etapa 9 del pipeline: POS Order Case (sync_from_ui con método de pago real)
    private async Task CheckoutAsync(string method, int? paymentMethodId)
    {
        if (cart.Count == 0 || isPaying) return;
        isPaying = true;
        payMessage = null;
        payError = null;
        StateHasChanged();
        try
        {
            // Revalida la caja aquí (estado incluido): solo 'opened' puede cobrar.
            var info = await OdooService.GetActiveSessionAsync();
            sessionId = info?.Id;
            sessionState = info?.State;

            if (info is null)
            {
                payError = "La caja está cerrada. Usa el botón “Abrir caja” del banner superior para abrirla sin salir de esta pantalla.";
                await LoadPosConfigsAsync();
                return;
            }

            if (!info.IsOpened)
            {
                payError = info.IsClosing
                    ? $"La caja #{info.Id} está en control de cierre. Usa el botón “Terminar cierre” para liberarla antes de vender."
                    : $"La caja #{info.Id} aún no está iniciada. Usa el botón “Iniciar caja” e indica el efectivo inicial.";
                return;
            }

            // Blindaje multicancha: revalida existencias justo antes de sincronizar
            // (otro cajero pudo vender). Una sola lectura; si falla, no bloquea la venta.
            try
            {
                var stock = await Pipeline.GetStockAsync(cart.Select(i => i.ProductId).ToList());
                if (stock.Count > 0)
                {
                    foreach (var p in products)
                        if (stock.TryGetValue(p.Id, out var a))
                            p.QtyAvailable = a;

                    var shortages = new List<string>();
                    foreach (var item in cart)
                    {
                        if (!stock.TryGetValue(item.ProductId, out var avail))
                            continue;
                        item.StockQty = avail;
                        if (avail <= 0)
                            shortages.Add($"“{item.Name}” se agotó.");
                        else if (item.Qty > (int)Math.Floor(avail))
                            shortages.Add($"“{item.Name}”: pides {item.Qty}, hay {avail:0.##}.");
                    }
                    if (shortages.Count > 0)
                    {
                        payError = "Existencias insuficientes: " + string.Join(" ", shortages) + " Ajusta el ticket e intenta de nuevo.";
                        return;
                    }
                }
            }
            catch
            {
                // Sin dato fresco no se bloquea la venta; Odoo es la fuente final.
            }

            // Etapa 9: sync_from_ui con el método de pago del config (puede ser null
            // y el servicio resuelve el primero disponible). info.IsOpened lo garantiza.
            var orderId = await Pipeline.CreateOrderAsync(info.Id, cart, Total, paymentMethodId, partnerId: selectedPartnerId > 0 ? selectedPartnerId : null);
            // Ticket estilo Odoo (ReceiptScreen): se captura antes de vaciar el carrito
            lastTicket = new TicketDto
            {
                OrderId = orderId,
                SessionId = info.Id,
                ConfigName = string.IsNullOrEmpty(sessionData?.ConfigName) ? "Punto de Venta" : sessionData.ConfigName,
                Date = DateTime.Now,
                Cashier = string.IsNullOrEmpty(AuthState.Username) ? "Cajero Odoo" : AuthState.Username,
                Customer = selectedPartnerId > 0 ? customers.FirstOrDefault(c => c.Id == selectedPartnerId)?.Name ?? "Cliente" : "Cliente Mostrador",
                MethodLabel = method == "cash" ? $"Efectivo ({CashMethodLabel})" : $"Tarjeta ({CardMethodLabel})",
                Lines = cart.Select(i => new TicketLine(i.Name, i.Qty, i.UnitPrice, i.LineTotal)).ToList(),
                Subtotal = Subtotal,
                Tax = Iva,
                Total = Total
            };
            payMessage = $"Orden #{orderId} creada en sesión #{info.Id} ({method}). Total ${Total:0.00}.";
            cart.Clear();
            showTicketModal = true;
        }
        catch (Exception ex)
        {
            payError = ex.Message.Contains("session_id", StringComparison.OrdinalIgnoreCase)
                ? "La caja está cerrada. Usa el botón “Abrir caja” del banner superior y vuelve a intentar."
                : $"No se pudo crear la orden: {ex.Message}";
        }
        finally
        {
            isPaying = false;
            StateHasChanged();
            await LoadProductsAsync();
        }
    }

