        }
        finally
        {
            isProcessingSession = false;
            StateHasChanged();
        }
    }

    private void AddToCart(ProductDto p) => AddToCartQty(p, 1);

    private void AddToCartQty(ProductDto p, int qty)
    {
        stockNotice = null;
        if (p.QtyAvailable <= 0 || qty <= 0) return;
        var max = (int)Math.Floor(p.QtyAvailable);
        // Impuestos reales del producto (del bundle de sesión): misma base que Odoo usará.
        // Sin impuestos configurados en Odoo → tasa fiscal por defecto (Pos:DefaultTaxRate).
        var taxIds = p.TaxIds ?? new();
        var rate = taxIds.Count == 0
            ? DefaultTaxRate
            : sessionData?.Taxes.Where(t => taxIds.Contains(t.Id)).Sum(t => t.Amount) ?? 0m;
        var existing = cart.FirstOrDefault(i => i.ProductId == p.Id);
        var current = existing?.Qty ?? 0;
        if (current >= max)
        {
            stockNotice = $"“{p.Name}” solo tiene {p.QtyAvailable:0.##} en existencia.";
            showProductModal = false;
            return;
        }
        var take = Math.Min(qty, max - current);
        if (existing is null)
            cart.Add(new CartItem { ProductId = p.Id, Name = p.Name, UnitPrice = p.Price, Qty = take, TaxIds = new(taxIds), TaxRate = rate, StockQty = p.QtyAvailable });
        else
        {
            existing.Qty += take;
            existing.StockQty = p.QtyAvailable;
        }
        if (take < qty)
            stockNotice = $"Solo se agregaron {take} de “{p.Name}” (existencia: {p.QtyAvailable:0.##}).";
        showProductModal = false;
    }

