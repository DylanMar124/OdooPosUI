@page "/"
@page "/login"
@rendermode InteractiveServer
@layout Layout.EmptyLayout
@using Odoo.WebUI.Services
@inject OdooService OdooService
@inject OdooAuthState AuthState
@inject NavigationManager NavigationManager

<PageTitle>Odoo POS - Iniciar Sesión</PageTitle>

<div class="min-h-screen font-sans antialiased text-slate-800 bg-slate-100 flex flex-col justify-between selection:bg-purple-100 selection:text-purple-900 transition-colors duration-300">

    <!-- Header sutil con selector de tema y estado de servidor -->
    <header class="w-full px-6 py-4 flex justify-between items-center text-xs text-slate-500 max-w-7xl mx-auto">
        <div class="flex items-center gap-2">
            <span class="inline-flex h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span class="font-medium text-slate-600">Powered By <strong class="font-semibold text-slate-800">Nexasoft</strong></span>
        </div>
    </header>

    <!-- Contenedor Principal Centrado -->
    <main class="flex-1 flex items-center justify-center px-4 py-8">
        <div class="w-full max-w-[460px] bg-white rounded-2xl shadow-xl shadow-slate-200/60 border border-slate-200/80 p-8 sm:p-10 transition-all">

            <!-- Logo odoo POS en la parte superior -->
            <div class="flex flex-col items-center text-center mb-7">
                <div class="h-12 w-auto mb-4 flex items-center justify-center">
                    <img src="https://lh3.googleusercontent.com/aida/AEtjO1VySIzsfY_x-MejS2o0Rcizxgz5ciRx2KHSm59aPNawSS0nwqXHpw_wNRrY0L5lLS9Vaurt671mTUkd7xtSMis6flkLyrJBifX7OyTbSB-mB5EqP6ntdZzO-QfIT6Db7lyG6hWfsZR4rwuMwHwF6L7ZrCDIIj2Et9wvC0rxubd7FRfdAoMhcTOJTy3tAT6j7wuZWi-P4RyhUEtjPc1ADlzIq6mWYrpY3NwzJBYI8j6syIoWQD5YRltwsjw" alt="Odoo POS Logo" class="h-10 w-auto object-contain" />
                </div>
                <h1 class="text-2xl font-extrabold tracking-tight text-slate-900">Punto de Venta</h1>
                <p class="text-sm text-slate-500 mt-1 font-medium">Inicia sesión en tu base Odoo</p>
            </div>

            <!-- Alerta de estado de error: "Credenciales inválidas" -->
            @if (showError)
            {
                <div class="mb-5 flex items-start gap-3 p-3.5 rounded-xl bg-rose-50/90 border border-rose-200/90 text-rose-800 text-xs transition-all">
                    <svg class="w-4 h-4 text-rose-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="10" stroke-width="2"></circle>
                        <line x1="12" y1="8" x2="12" y2="12" stroke-width="2" stroke-linecap="round"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16" stroke-width="2" stroke-linecap="round"></line>
                    </svg>
                    <div class="flex-1">
                        <span class="font-semibold">Credenciales inválidas.</span>
                        <span class="text-rose-700/90 block mt-0.5">Por favor comprueba la base de datos, usuario o contraseña e intenta de nuevo.</span>
                    </div>
                    <button type="button" @onclick="() => showError = false" class="text-rose-500 hover:text-rose-700 p-0.5 rounded">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                    </button>
                </div>
            }

            <!-- Formulario de Login -->
            <form @onsubmit="HandleLogin" @onsubmit:preventDefault="true" class="space-y-4">
                <!-- Campo: Database -->
                <div>
                    <label for="database" class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">
                        Base de Datos Odoo
                    </label>
                    <div class="relative rounded-xl shadow-sm">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"></path>
                            </svg>
                        </div>
                        <input type="text" id="database" @bind="db" required disabled="@isLoading"
                               class="block w-full rounded-xl border border-slate-200 pl-10 pr-3.5 py-2.5 text-sm text-slate-800 placeholder-slate-400 font-medium focus:border-[#714B67] focus:ring-2 focus:ring-[#714B67]/20 focus:outline-none transition bg-slate-50/50 hover:bg-white"
                               placeholder="nombre_de_base_odoo" />
                    </div>
                </div>

                <!-- Campo: Email / Username -->
                <div>
                    <label for="username" class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">
                        Correo / Usuario
                    </label>
                    <div class="relative rounded-xl shadow-sm">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                            </svg>
                        </div>
                        <input type="text" id="username" @bind="username" required disabled="@isLoading"
                               class="block w-full rounded-xl border border-slate-200 pl-10 pr-3.5 py-2.5 text-sm text-slate-800 placeholder-slate-400 font-medium focus:border-[#714B67] focus:ring-2 focus:ring-[#714B67]/20 focus:outline-none transition bg-slate-50/50 hover:bg-white"
                               placeholder="cajero@empresa.com" />
                    </div>
                </div>

                <!-- Campo: Password -->
                <div>
                    <div class="flex items-center justify-between mb-1.5">
                        <label for="password" class="block text-xs font-bold uppercase tracking-wider text-slate-600">
                            Contraseña
                        </label>
                        <a href="#" class="text-xs font-semibold text-[#714B67] hover:underline">¿Olvidaste tu clave?</a>
                    </div>
                    <div class="relative rounded-xl shadow-sm">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                            </svg>
                        </div>
                        <input type="@(showPassword ? "text" : "password")" id="password" @bind="password" required disabled="@isLoading"
                               class="block w-full rounded-xl border border-slate-200 pl-10 pr-10 py-2.5 text-sm text-slate-800 placeholder-slate-400 font-medium focus:border-[#714B67] focus:ring-2 focus:ring-[#714B67]/20 focus:outline-none transition bg-slate-50/50 hover:bg-white"
                               placeholder="Ingresa tu contraseña" />
                        <button type="button" @onclick="() => showPassword = !showPassword" class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-slate-600">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                            </svg>
                        </button>
                    </div>
                </div>

                <!-- Checkbox: Recordarme -->
                <div class="flex items-center justify-between pt-1">
                    <label class="flex items-center gap-2.5 cursor-pointer select-none">
                        <input type="checkbox" @bind="rememberMe"
                               class="w-4 h-4 rounded border-slate-300 text-[#714B67] focus:ring-[#714B67]/30 focus:ring-offset-0 transition cursor-pointer" />
                        <span class="text-xs font-medium text-slate-600">Recordarme en este equipo</span>
                    </label>
                </div>

                <!-- Botón Primario "Ingresar" con Estado Normal y de Carga -->
                <div class="pt-3">
                    <button type="submit" disabled="@isLoading"
                            class="relative w-full flex items-center justify-center gap-2 py-3 px-4 rounded-xl text-sm font-bold text-white bg-[#714B67] hover:bg-[#5c3a53] active:scale-[0.99] transition shadow-md shadow-[#714B67]/25 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#714B67] disabled:opacity-70 disabled:cursor-wait">
                        @if (!isLoading)
                        {
                            <span class="flex items-center gap-2">
                                Ingresar al Punto de Venta
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                                </svg>
                            </span>
                        }
                        else
                        {
                            <span class="flex items-center gap-2">
                                <svg class="animate-spin h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                </svg>
                                <span>Conectando a Odoo...</span>
                            </span>
                        }
                    </button>
                </div>
            </form>
        </div>
    </main>
</div>

@code {
    private string db = "odoo_Db";
    private string username = "correo@correo.com";
    private string password = string.Empty;
    private bool rememberMe = true;
    private bool showPassword;
    private bool isLoading;
    private bool showError;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Si ya hay sesión persistida (p. ej. F5 o pestaña recordada), entra directo al POS
        if (await AuthState.TryRestoreAsync())
        {
            NavigationManager.NavigateTo("/pos");
            return;
        }

        // Prefill con identidad guardada o defaults de appsettings
        var saved = await AuthState.GetSavedIdentityAsync();
        if (saved.HasValue)
        {
            db = saved.Value.Db;
            username = saved.Value.Username;
        }
        else
        {
            if (!string.IsNullOrEmpty(AuthState.DefaultDb)) db = AuthState.DefaultDb;
            if (!string.IsNullOrEmpty(AuthState.DefaultUsername)) username = AuthState.DefaultUsername;
        }
        StateHasChanged();
    }

    private async Task HandleLogin()
    {
        showError = false;
        isLoading = true;
        try
        {
            var uid = await AuthState.LoginAsync(db, username, password, rememberMe);
            if (uid > 0)
            {
                NavigationManager.NavigateTo("/pos");
            }
            else
            {
                showError = true;
            }
        }
        catch
        {
            showError = true;
        }
        finally
        {
            isLoading = false;
        }
    }
}
